\name{indort}
\alias{indort}
\title{Orthogonal INDSCAL (INDORT)}
\usage{
indort(S, R = 1, normaliser = TRUE, nstart = 10,
       maxit = 1000, tol = 1e-8, seed = NULL)
}
\arguments{
\item{S}{list of \eqn{n \times n} scalar product matrices \eqn{W_k}, one per block (see \code{\link{blocs_vers_S}}).}

\item{R}{number of components (extracted simultaneously; solutions are not nested in R).}

\item{normaliser}{logical; scale each \eqn{W_k} to unit trace.}

\item{nstart}{number of starts: the CPCA solution plus \code{nstart - 1} random orthonormal matrices.}

\item{maxit}{maximum number of iterations per start.}

\item{tol}{tolerance on the relative norm of the Riemannian gradient.}

\item{seed}{optional random seed.}

}
\value{
An object of class \code{"vosa_fit"}, a list with
\item{methode}{name of the method.}
\item{alpha}{value of \eqn{\alpha} in the family \eqn{g_\alpha} (\code{NA} for STATIS).}
\item{U}{\eqn{n \times R} matrix of orthonormal components.}
\item{saliences}{\eqn{K \times R} matrix of saliences \eqn{a_k(u_r) = u_r'W_ku_r}.}
\item{resume}{data frame with, for each dimension, the level \eqn{\bar a}, the squared level, the contrast \eqn{V} (variance of the saliences, divisor \eqn{K}), \eqn{L^2 = \bar a^2 + V} and \eqn{\rho = \bar a^2 / V}.}
\item{n, K, plafonds}{number of individuals, number of blocks, ceilings \eqn{\pi_{k1}} of the blocks.}
\item{blocs}{normalized data blocks when available (used by \code{\link{factorisation_canonique}}), otherwise \code{NULL}.}
and method-specific components described in the corresponding help page.

For INDORT, in addition: \code{critere} (\eqn{F(U)}), \code{iterations}, \code{converge} and \code{criteres_departs} (criterion reached by each start, to detect local maxima).
}
\description{
Simultaneous extraction of \code{R} orthonormal components maximizing \eqn{F(U) = \sum_r\sum_k a_k(u_r)^2}, the criterion of the orthogonal INDSCAL model \eqn{W_k \approx U\Lambda_kU'}. For \code{R = 1}, this is the first dimension of ComDim / CCSWA (ACCPS). This is the point \eqn{\alpha = 1/2} of the family \eqn{g_\alpha}.
}
\details{
The algorithm is the polar ascent \eqn{U \leftarrow \mathrm{polar}(M)}, where the column \eqn{r} of \eqn{M} is \eqn{(\sum_k a_k(u_r)W_k)u_r}. Its ascent is guaranteed because the \eqn{W_k} are positive semi-definite. The dimensions are returned by decreasing contribution to the criterion, with the largest entry of each component positive.
}
\references{
Ballah Houssein, S., Galharret, J.-M. and Hanafi, M. (2026). VOSA: variance-optimized saliences analysis. Manuscript.

Kiers, H. A. L. (1989). A computational short-cut for INDSCAL with orthonormality constraints on positive semi-definite matrices of low rank. Computational Statistics Quarterly, 5, 119--135.
}
\seealso{
\code{\link{cpca}}, \code{\link{indort}}, \code{\link{spa}}, \code{\link{statis}}, \code{\link{factorisation_canonique}}
}
\examples{
sim <- simuler_blocs(seed = 1)
fit <- indort(blocs_vers_S(sim$X), R = 2, nstart = 3, seed = 1)
fit$resume
}
