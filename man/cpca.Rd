% Generated by hand, consistent with the roxygen comments in R/
% Please edit documentation in R/cpca.R
\name{cpca}
\alias{cpca}
\title{Consensus PCA (CPCA)}
\usage{
cpca(S, R = 1, normaliser = TRUE)
}
\arguments{
\item{S}{list of \eqn{n \times n} scalar product matrices \eqn{W_k}, one per block (see \code{\link{blocs_vers_S}}).}

\item{R}{number of components.}

\item{normaliser}{logical; scale each \eqn{W_k} to unit trace (recommended: saliences are then shares of inertia).}

}
\value{
An object of class \code{"vosa_fit"}, a list with
\item{methode}{name of the method.}
\item{alpha}{value of \eqn{\alpha} in the family \eqn{g_\alpha} (\code{NA} for STATIS).}
\item{U}{\eqn{n \times R} matrix of orthonormal components.}
\item{saliences}{\eqn{K \times R} matrix of saliences \eqn{a_k(u_r) = u_r'W_ku_r}.}
\item{resume}{data frame with, for each dimension, the level \eqn{\bar a}, the squared level, the contrast \eqn{V} (variance of the saliences, divisor \eqn{K}), \eqn{L^2 = \bar a^2 + V} and \eqn{\rho = \bar a^2 / V}.}
\item{n, K, plafonds}{number of individuals, number of blocks, ceilings \eqn{\pi_{k1}} of the blocks.}
\item{blocs}{normalized data blocks when available (used by \code{\link{factorisation_canonique}}), otherwise \code{NULL}.}
and method-specific components described in the corresponding help page.

For CPCA, in addition: \code{valeurs_propres} (eigenvalues of \eqn{\bar W}, equal to the levels), \code{critere} and \code{Wbar}.
}
\description{
Maximizes the sum of the saliences of the components, \eqn{\max_{U'U=I}\sum_r\sum_k a_k(u_r) = K\,\mathrm{tr}(U'\bar W U)}: the components are the first eigenvectors of \eqn{\bar W = K^{-1}\sum_k W_k}. This is the point \eqn{\alpha = 0} of the family \eqn{g_\alpha}; the first component maximizes the level of the saliences.
}
\references{
Ballah Houssein, S., Galharret, J.-M. and Hanafi, M. (2026). VOSA: variance-optimized saliences analysis. Manuscript.
}
\seealso{
\code{\link{cpca}}, \code{\link{indort}}, \code{\link{spa}}, \code{\link{statis}}, \code{\link{factorisation_canonique}}
}
\examples{
sim <- simuler_blocs(seed = 1)
fit <- cpca(blocs_vers_S(sim$X), R = 2)
fit
}
