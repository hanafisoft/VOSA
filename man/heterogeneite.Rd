\name{heterogeneite}
\alias{heterogeneite}
\title{Heterogeneity of the block structures}
\usage{
heterogeneite(S, U = NULL)
}
\arguments{
\item{S}{list of \eqn{n \times n} scalar product matrices \eqn{W_k}, one per block (see \code{\link{blocs_vers_S}}).}

\item{U}{optional \eqn{n \times R} matrix of orthonormal components, or an object of class \code{"vosa_fit"}.}

}
\value{
A list with \code{H}, \code{H_relative}, \code{indice_RV} and, when \code{U} is given, \code{part_restituee} (by dimension) and \code{part_cumulee}.
