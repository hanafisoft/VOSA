\name{diagnostic_blocs}
\alias{diagnostic_blocs}
\title{Comparison of the components with the block principal components}
\usage{
diagnostic_blocs(fit, S)
}
\arguments{
\item{fit}{an object of class \code{"vosa_fit"}.}

\item{S}{list of \eqn{n \times n} scalar product matrices \eqn{W_k}, one per block (see \code{\link{blocs_vers_S}}).}

}
\value{
A data frame with one row per block and dimension: \code{bloc}, \code{dimension}, \code{salience}, \code{plafond}, \code{fraction_plafond}, \code{cos2_cp1} and \code{au_dessus_niveau}.
}
\description{
For each block and each dimension of a fitted model, gives the salience, the ceiling, the fraction of the ceiling reached, the squared cosine with the first principal component of the block, and whether the salience exceeds the level of the dimension. A component close to the first principal component of a single block designates that block and provides its direction; close to those of several blocks, it is a direction shared by this subset of blocks.
