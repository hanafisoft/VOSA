\alias{print.vosa_chemin}
\alias{print.vosa_factorisation}
\title{Print, summary and plot methods}
\usage{
\method{print}{vosa_fit}(x, digits = 3, ...)

\method{summary}{vosa_fit}(object, ...)

\method{plot}{vosa_fit}(x, dim = 1, main = NULL, ...)

\method{print}{vosa_chemin}(x, digits = 4, ...)

\method{print}{vosa_factorisation}(x, digits = 3, ...)
}
\arguments{
\item{x, object}{an object of class \code{"vosa_fit"}, \code{"vosa_chemin"} or \code{"vosa_factorisation"}.}

\item{digits}{number of digits printed.}

\item{dim}{dimension to plot.}

\item{main}{title of the plot (by default, the method and the dimension).}

\item{...}{further arguments passed to \code{barplot} (plot) or ignored.}

}
\value{
\code{print} and \code{plot} return \code{x} invisibly; \code{summary} returns, invisibly, a list with the saliences and ceilings, the summary and the floor.
}
\description{
\code{print} shows the method, the table of saliences and the level/contrast summary of each dimension; \code{summary} adds the ceilings of the blocks and the floor; \code{plot} draws the saliences of one dimension as a bar chart, with the ceilings of the blocks (triangles) and the level of the dimension (dashed line).
}
