\name{factorisation_canonique}
\alias{factorisation_canonique}
\title{Canonical factorization of a fitted model}
\usage{
factorisation_canonique(fit, blocs = NULL)
}
\arguments{
\item{fit}{an object of class \code{"vosa_fit"}, returned by \code{cpca}, \code{indort}, \code{spa}, \code{vosa} or \code{statis}.}

\item{blocs}{list of data blocks; by default the normalized blocks stored in \code{fit}, available when \code{S} was built with \code{blocs_vers_S} or \code{bloc_W}.}

}
\value{
An object of class \code{"vosa_factorisation"}, a list with
\item{U}{components (\eqn{n \times R}).}
\item{D}{\eqn{K \times R} matrix of the diagonal terms \eqn{d_{kr}} of the \eqn{D_k}.}
\item{V}{list of the \eqn{p_k \times R} loading matrices \eqn{V_k}.}
\item{E}{list of the residual matrices \eqn{E_k}.}
\item{part_restituee}{\eqn{K \times R} matrix \eqn{d_{kr}^2/\|X_k\|^2}, the share of the inertia of each block reproduced by each dimension (equal to the saliences for unit-inertia blocks).}
\item{part_residuelle}{share of the inertia of each block left in \eqn{E_k}.}
\item{erreur_reconstruction}{maximum absolute value of \eqn{UD_kV_k' + E_k - X_k} (numerical check).}
\item{methode}{name of the method.}
}
\description{
Writes a fitted multiblock model in the canonical factorization common to multiblock methods,
\deqn{X_k = U D_k V_k' + E_k,}
where \eqn{U} (\eqn{n \times R}, \eqn{U'U = I}) holds the components, \eqn{D_k} is diagonal with \eqn{d_{kr} = \|X_k'u_r\|}, \eqn{V_k = X_k'UD_k^{-1}} has unit-norm columns (block loadings) and \eqn{E_k = (I - UU')X_k} is the residual. When the blocks are scaled to unit inertia (as by \code{\link{blocs_vers_S}} or \code{\link{bloc_W}}), \eqn{d_{kr}^2} is the salience \eqn{a_k(u_r)}.
}
\references{
Bougeard, S., Peltier, C., Jaillais, B., Boulet, J.-C. and Hanafi, M. (2024). Benchmarking multiblock methods with canonical factorization. Chemometrics and Intelligent Laboratory Systems, 254, 105240.
}
\seealso{
\code{\link{plot_U}}, \code{\link{plot_D}}, \code{\link{plot_V}} for the plots of \eqn{U}, \eqn{D_k} and \eqn{V_k};
\code{\link{cpca}}, \code{\link{indort}}, \code{\link{spa}}, \code{\link{statis}}, \code{\link{factorisation_canonique}}
}
\examples{
sim <- simuler_blocs(seed = 3)
fit <- indort(blocs_vers_S(sim$X), R = 2, nstart = 3, seed = 3)
fc <- factorisation_canonique(fit)
fc
all.equal(unname(fc$D^2), unname(fit$saliences))
plot(fc, type = "D")
}
