\name{spa}
\alias{spa}
\alias{vosa}
\title{Family g_alpha and VOSA computed by Shifted Polar Ascent (SPA)}
\usage{
spa(S, alpha, R = 1, normaliser = TRUE, nstart = 10, U0 = NULL,
    maxit = 1000, tol = 1e-6, seed = NULL)

vosa(S, R = 1, ...)
}
\arguments{
\item{S}{list of \eqn{n \times n} scalar product matrices \eqn{W_k}, one per block (see \code{\link{blocs_vers_S}}).}

\item{alpha}{weight of the contrast, in \eqn{[0, 1]}: 0 gives CPCA, 1/2 INDORT, 1 VOSA.}

\item{R}{number of components (extracted simultaneously).}

\item{normaliser}{logical; scale each \eqn{W_k} to unit trace.}

\item{nstart}{number of random starts, added to the CPCA solution and to \code{U0}.}

\item{U0}{optional start: an \eqn{n \times R} matrix or a list of such matrices, e.g. the solution for a neighbouring value of \code{alpha}.}

\item{maxit}{maximum number of iterations per start.}

\item{tol}{tolerance on the relative norm of the Riemannian gradient.}

\item{seed}{optional random seed.}

\item{...}{arguments passed from \code{vosa()} to \code{spa()}.}

}
\value{
An object of class \code{"vosa_fit"}, a list with
\item{methode}{name of the method.}
\item{alpha}{value of \eqn{\alpha} in the family \eqn{g_\alpha} (\code{NA} for STATIS).}
\item{U}{\eqn{n \times R} matrix of orthonormal components.}
\item{saliences}{\eqn{K \times R} matrix of saliences \eqn{a_k(u_r) = u_r'W_ku_r}.}
\item{resume}{data frame with, for each dimension, the level \eqn{\bar a}, the squared level, the contrast \eqn{V} (variance of the saliences, divisor \eqn{K}), \eqn{L^2 = \bar a^2 + V} and \eqn{\rho = \bar a^2 / V}.}
\item{n, K, plafonds}{number of individuals, number of blocks, ceilings \eqn{\pi_{k1}} of the blocks.}
\item{blocs}{normalized data blocks when available (used by \code{\link{factorisation_canonique}}), otherwise \code{NULL}.}
and method-specific components described in the corresponding help page.

For SPA and VOSA, in addition: \code{resume$g_alpha}, \code{G_alpha} (value of the criterion), \code{iterations}, \code{converge}, \code{decalage} (shift \eqn{c}) and \code{criteres_departs}.
}
\description{
Maximizes \eqn{G_\alpha(U) = R^{-1}\sum_r g_\alpha(u_r)}, with \eqn{g_\alpha(u) = (1-\alpha)\bar a(u)^2 + \alpha V(u)}, where \eqn{\bar a(u)} (level) and \eqn{V(u)} (contrast) are the mean and the variance of the saliences \eqn{a_k(u) = u'W_ku}. \code{vosa()} is \code{spa()} with \code{alpha = 1}: VOSA maximizes the variance of the saliences of a component, that is the contrast between the blocks it reproduces strongly and those it reproduces weakly.
}
\details{
The criterion is that of INDORT applied to the \eqn{J = K+1} blocks \eqn{B_k = \sqrt{\alpha/K}(W_k - \bar W)}, \eqn{k = 1, \dots, K}, and \eqn{B_{K+1} = \sqrt{1-\alpha}\,\bar W}, which are indefinite when \eqn{\alpha > 0}. The SPA algorithm computes once the shift \eqn{c = \sum_j\lambda^+_{\max}(B_j)\lambda^-_{\min}(B_j)} (SPA-0); at each iteration it computes \eqn{M = \sum_jB_jU\mathrm{diag}(b_j(u_1),\dots,b_j(u_R))} with \eqn{b_j(u) = u'B_ju} (SPA-2), the two candidates \eqn{\mathrm{polar}(M)} and \eqn{\mathrm{polar}(cU + M)} (SPA-3), keeps the one with the larger criterion (SPA-4), and stops when the relative norm of the Riemannian gradient is below \code{tol} (SPA-5). The shifted candidate guarantees that the criterion increases at each iteration.

For \eqn{\alpha} close to 1, the criterion has several local maxima: use several starts, or the path \code{\link{chemin_spa}}, which sweeps \eqn{\alpha} in both directions.
}
\references{
Ballah Houssein, S., Galharret, J.-M. and Hanafi, M. (2026). VOSA: variance-optimized saliences analysis. Manuscript.

Journee, M., Nesterov, Y., Richtarik, P. and Sepulchre, R. (2010). Generalized power method for sparse principal component analysis. Journal of Machine Learning Research, 11, 517--553.

Kolda, T. G. and Mayo, J. R. (2011). Shifted power method for computing tensor eigenpairs. SIAM Journal on Matrix Analysis and Applications, 32, 1095--1124.
}
\seealso{
\code{\link{chemin_spa}}, \code{\link{borne_relative}}, \code{\link{factorisation_canonique}}
}
\examples{
sim <- simuler_blocs(seed = 1)
S <- blocs_vers_S(sim$X)
fit <- vosa(S, R = 1, nstart = 5, seed = 1)
fit
# squared cosine with the block-specific factor
sum(fit$U[, 1] * sim$t_d)^2
factorisation_canonique(fit)
}
