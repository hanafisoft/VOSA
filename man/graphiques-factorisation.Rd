% Generated by hand, consistent with the roxygen comments in R/
% Please edit documentation in R/graphiques.R
\name{graphiques-factorisation}
\alias{graphiques-factorisation}
\alias{plot_U}
\alias{plot_D}
\alias{plot_V}
\alias{plot.vosa_factorisation}
\title{Plots of the canonical factorization: components U, diagonal terms D_k and loadings V_k}
\usage{
plot_U(x, dims = c(1, 2), groupes = NULL, etiquettes = NULL, main = NULL, ...)

plot_D(x, carre = TRUE, main = NULL, ...)

plot_V(
  x,
  bloc = 1,
  dims = 1,
  axe = NULL,
  etiquettes = NULL,
  n_etiquettes = 10,
  main = NULL,
  ...
)

\method{plot}{vosa_factorisation}(x, type = c("D", "U", "V"), ...)
}
\arguments{
\item{x}{an object of class \code{"vosa_factorisation"} (from \code{\link{factorisation_canonique}}) or, for \code{plot_U} and \code{plot_D}, an object of class \code{"vosa_fit"}.}

\item{dims}{one or two dimensions to plot.}

\item{groupes}{optional factor (one value per individual) used to colour the individuals.}

\item{etiquettes}{logical; write the names (or numbers) of the individuals (by default when \eqn{n \le 50}) or of the variables (by default; when the block has more than 40 variables, only the \code{n_etiquettes} variables with the largest loadings are labelled).}

\item{n_etiquettes}{number of variables labelled in \code{plot_V} when the block has more than 40 variables.}

\item{carre}{logical; plot \eqn{d_{kr}^2} (the saliences) rather than \eqn{d_{kr}}.}

\item{bloc}{block whose loadings are plotted (number or name).}

\item{axe}{optional numeric abscissa for the variables of the block (for instance wavelengths or chemical shifts), used when one dimension is plotted.}

\item{main}{title of the plot (by default, the method, and the block for \code{plot_V}).}

\item{type}{for \code{plot()}: \code{"D"}, \code{"U"} or \code{"V"}.}

\item{...}{further graphical arguments passed to \code{plot} or \code{barplot} or, for \code{plot()}, to the selected function (for instance \code{bloc} or \code{dims}).}
}
\value{
The plotted values, invisibly: the scores, the matrix of the \eqn{d_{kr}} (or of their squares), or the loadings.
}
\description{
Graphical representations of the three elements of the canonical factorization \eqn{X_k = U D_k V_k' + E_k}.

\code{plot_U} draws the individuals on the components \eqn{U}: against their index for one dimension, or as a scatter plot for two dimensions, optionally coloured by groups.

\code{plot_D} draws the diagonal terms \eqn{d_{kr}} of the \eqn{D_k}, or their squares (the saliences, shares of the inertia of each block reproduced by each dimension), as a bar chart of blocks by dimensions.

\code{plot_V} draws the loadings \eqn{V_k} of one block: as a profile against the variables for one dimension (a line when the block has more than 40 variables, for instance a spectrum, vertical bars otherwise), or as a scatter plot of the variables for two dimensions.

\code{plot()} on an object of class \code{"vosa_factorisation"} calls one of these functions according to \code{type}.
}
\examples{
sim <- simuler_blocs(pi_d = c(0.3, 0, 0, 0), seed = 5)
fit <- vosa(blocs_vers_S(sim$X), R = 2, nstart = 3, seed = 5)
fc <- factorisation_canonique(fit)
plot_D(fc)
plot_U(fc, groupes = factor(sim$t_d > 0, labels = c("t_d < 0", "t_d > 0")))
plot_V(fc, bloc = 1, dims = 1)
plot_V(fc, bloc = 1, dims = 1:2)
plot(fc, type = "D")
}
\seealso{
\code{\link{factorisation_canonique}}
}
