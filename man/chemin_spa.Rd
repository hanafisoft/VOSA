\name{chemin_spa}
\alias{chemin_spa}
\title{Path of solutions of the family g_alpha}
\usage{
chemin_spa(S, alphas = seq(0, 1, by = 0.05), R = 1, normaliser = TRUE,
           nstart = 10, maxit = 1000, tol = 1e-6, seed = NULL)
}
\arguments{
\item{S}{list of \eqn{n \times n} scalar product matrices \eqn{W_k}, one per block (see \code{\link{blocs_vers_S}}).}

\item{alphas}{grid of values of \eqn{\alpha} in \eqn{[0, 1]}.}

\item{R}{number of components.}

\item{normaliser}{logical; scale each \eqn{W_k} to unit trace.}

\item{nstart}{number of random starts for each value of alpha.}

\item{maxit}{maximum number of iterations per start.}

\item{tol}{tolerance of the algorithm.}

\item{seed}{optional random seed.}

}
\value{
An object of class \code{"vosa_chemin"}, a list with
\item{chemin}{data frame with, for each \eqn{\alpha}, the squared level, the contrast and \eqn{L^2} (means over the \code{R} dimensions), and \eqn{G_\alpha}.}
\item{solutions}{list of the fitted objects (class \code{"vosa_fit"}).}
\item{R}{number of components.}
}
\description{
Solves the family \eqn{g_\alpha} on a grid of values of \eqn{\alpha}, with an increasing sweep (random starts plus the solution of the previous value) and a decreasing sweep (the solution of the next value is kept when it improves the criterion). Along the path, the contrast increases and the level decreases with \eqn{\alpha}.
}
\seealso{
\code{\link{spa}}, \code{\link{borne_relative}}
}
\examples{
sim <- simuler_blocs(seed = 2)
ch <- chemin_spa(blocs_vers_S(sim$X), alphas = seq(0, 1, by = 0.25),
                 nstart = 3, seed = 2)
ch
borne_relative(ch)
}
