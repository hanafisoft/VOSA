}
\arguments{
\item{S}{list of \eqn{n \times n} scalar product matrices \eqn{W_k}, one per block (see \code{\link{blocs_vers_S}}).}

\item{R}{number of components.}

\item{normalisation}{\code{"RV"} (classical STATIS: each \eqn{W_k} has unit Frobenius norm in the interstructure) or \code{"trace"} (unit trace, as for CPCA and INDORT).}

