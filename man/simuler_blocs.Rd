\name{simuler_blocs}
\alias{simuler_blocs}
\title{Simulated multiblock data}
\usage{
simuler_blocs(n = 30, K = 4, p = 100, pi_c = c(0.20, 0.15, 0.10),
              pi_d = c(0.30, 0.30, 0, 0), seed = NULL)
}
\arguments{
\item{n}{number of individuals.}

\item{K}{number of blocks.}

\item{p}{number of variables per block.}

\item{pi_c}{shares of inertia of the factors common to all blocks.}

\item{pi_d}{vector of length \code{K}: share of inertia of the factor \eqn{t_d} in each block.}

\item{seed}{optional random seed.}

}
\value{
A list with \code{X} (list of the \code{K} blocks), \code{t_d} (the block-specific factor) and \code{T} (matrix of all factors, the last column being \eqn{t_d}).
}
\description{
Generator used in the simulation study of the article: \code{n} individuals and \code{K} blocks of \code{p} variables; factors present in all blocks with shares of inertia \code{pi_c}, and a factor \eqn{t_d} present in block \eqn{k} with share \code{pi_d[k]}. The factors are centred and orthonormal; each block has its own random loadings; the remaining inertia is Gaussian noise. Each block is centred and scaled to unit inertia.
}
\examples{
sim <- simuler_blocs(pi_d = c(0.3, 0, 0, 0), seed = 4)
